# ARISE Environment Variables Example

# Server Configuration
VITE_ARISE_API_URL=https://your-backend-service.onrender.com/api/v1
VITE_APP_ENV=development

# Fastify Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=*

# Supabase Cloud PostgreSQL Database Configuration
# Runtime Pooled Connection (Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Migration Connection (Port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Coasty Computer Use API Credentials
COASTY_API_KEY=your_coasty_api_key_here
COASTY_BASE_URL=https://coasty.ai/v1
COASTY_MACHINE_ID=c0380719-b0cf-4e99-ac83-4bbf55ff3932
COASTY_CUA_VERSION=v3
COASTY_DEFAULT_MAX_STEPS=75
COASTY_DEFAULT_DEADLINE_SECONDS=600

# Safety Guard Flag
FINAL_COMPETITION_EXECUTION_ENABLED=false
