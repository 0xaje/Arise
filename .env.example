# ARISE Environment Variables Example

# Server Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Fastify Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arise_db

# Coasty Computer Use API Credentials (KEEP SECURE)
COASTY_API_KEY=your_coasty_api_key_here
COASTY_BASE_URL=https://coasty.ai/v1
COASTY_MACHINE_ID=your_coasty_machine_id_here
COASTY_CUA_VERSION=v3
COASTY_DEFAULT_MAX_STEPS=75
COASTY_DEFAULT_DEADLINE_SECONDS=600

# Safety Guard Flag
FINAL_COMPETITION_EXECUTION_ENABLED=false
